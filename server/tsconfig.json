{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../dist-server",
    "sourceMap": true
  },
  "include": [".", "../shared"],
  // Tests are typechecked by tsconfig.test.json. Keeping them out of the build
  // stops `dist-server` shipping code that imports a devDependency.
  "exclude": ["__tests__", "../shared/**/*.test.ts"]
}
